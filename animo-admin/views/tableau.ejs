<%# PAGE 1 — Tableau de bord %>
<%- include('partials/haut') %>

<div class="tete-page">
  <div>
    <p class="surtitre"><%= f.dateLongue() %></p>
    <h1>Bonjour 👋</h1>
  </div>
</div>

<% if (existeDemo) { %>
<%# Les données DÉMO ne sont jamais mélangées aux vrais chiffres sans le dire %>
<div class="bascule-vue" role="group" aria-label="Chiffres affichés">
  <a href="/" class="<%= avecDemo ? '' : 'active' %>" <%- avecDemo ? '' : 'aria-current="true"' %>>Chiffres réels</a>
  <a href="/?vue=demo" class="<%= avecDemo ? 'active' : '' %>" <%- avecDemo ? 'aria-current="true"' : '' %>>Avec la DÉMO</a>
</div>
<% if (avecDemo) { %>
<div class="bandeau-demo" role="note"><%- icone('alerte') %><span><strong>DÉMO</strong> — ces chiffres incluent des données fictives de démonstration. Ce ne sont pas vos vrais résultats.</span></div>
<% } %>
<% } %>

<section class="hero" aria-label="Revenus du mois">
  <div class="hero-haut"><%- icone('paiements') %><span>Revenus du mois</span><% if (avecDemo) { %><span class="badge-demo">DÉMO</span><% } %></div>
  <p class="hero-chiffre"><%= f.fcfa(chiffres.revenusMois) %></p>
  <p class="hero-bas"><%= f.moisEnCours() %> · <%= f.pluriel(chiffres.paiementsMois, 'paiement validé', 'paiements validés') %></p>
</section>

<section class="tuiles" aria-label="Chiffres clés">
  <a class="tuile" href="/clients">
    <span class="tuile-icone violet"><%- icone('clients') %></span>
    <span class="tuile-label">Clients <%- badgeDemo(avecDemo) %></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.clients) %></strong>
    <span class="tuile-detail">dont <%= f.nombre(chiffres.essais) %> en essai</span>
  </a>
  <a class="tuile" href="/clients?statut=actif">
    <span class="tuile-icone violet"><%- icone('check') %></span>
    <span class="tuile-label">Abonnés actifs <%- badgeDemo(avecDemo) %></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.actifs) %></strong>
    <span class="tuile-detail">abonnement payé en cours</span>
  </a>
  <a class="tuile" href="/commandes?statut=terminee">
    <span class="tuile-icone corail"><%- icone('videos') %></span>
    <span class="tuile-label">Vidéos aujourd'hui <%- badgeDemo(avecDemo) %></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.videosJour) %></strong>
    <span class="tuile-detail">fabriquées et terminées</span>
  </a>
  <a class="tuile" href="/commandes?statut=terminee">
    <span class="tuile-icone corail"><%- icone('graphique') %></span>
    <span class="tuile-label">Vidéos ce mois <%- badgeDemo(avecDemo) %></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.videosMois) %></strong>
    <span class="tuile-detail"><%= f.moisEnCours() %></span>
  </a>
</section>

<% if (!demarrage.offres || !demarrage.gabarits || !demarrage.clients) { %>
<section class="carte">
  <h2 class="carte-titre">Premiers pas</h2>
  <ol class="etapes">
    <li><% if (demarrage.offres) { %><span class="fait"><%- icone('check') %>Créer vos offres</span><% } else { %><a href="/offres/nouvelle"><%- icone('offres') %>1. Créer vos offres d'abonnement</a><% } %></li>
    <li><% if (demarrage.gabarits) { %><span class="fait"><%- icone('check') %>Créer vos gabarits</span><% } else { %><a href="/gabarits/nouveau"><%- icone('gabarits') %>2. Créer vos gabarits de vidéos</a><% } %></li>
    <li><% if (demarrage.clients) { %><span class="fait"><%- icone('check') %>Ajouter un client</span><% } else { %><a href="/clients/nouveau"><%- icone('clients') %>3. Ajouter votre premier client</a><% } %></li>
    <% if (!existeDemo) { %>
    <li><a href="/parametres#demo"><%- icone('oeil') %>Voir l'app remplie avec des données DÉMO</a></li>
    <% } %>
  </ol>
</section>
<% } %>

<section class="carte" aria-labelledby="titre-a-traiter">
  <h2 class="carte-titre" id="titre-a-traiter">À traiter <%- badgeDemo(avecDemo) %></h2>
  <% const total = aTraiter.paiements + aTraiter.attente + aTraiter.echecs + aTraiter.bientotExpires; %>
  <% if (!total) { %>
  <p class="aide">Rien à traiter pour le moment ✅</p>
  <% } else { %>
  <div class="actions-liste">
    <a class="action-ligne" href="/paiements?statut=en_attente">
      <span class="pastille-chiffre <%= aTraiter.paiements ? 'chaude' : '' %>"><%= aTraiter.paiements %></span>
      <span>Paiements à valider</span><%- icone('chevron') %>
    </a>
    <a class="action-ligne" href="/commandes?statut=en_attente">
      <span class="pastille-chiffre <%= aTraiter.attente ? 'chaude' : '' %>"><%= aTraiter.attente %></span>
      <span>Vidéos en attente de rendu</span><%- icone('chevron') %>
    </a>
    <a class="action-ligne" href="/commandes?statut=echec">
      <span class="pastille-chiffre <%= aTraiter.echecs ? 'chaude' : '' %>"><%= aTraiter.echecs %></span>
      <span>Vidéos en échec</span><%- icone('chevron') %>
    </a>
    <a class="action-ligne" href="/clients?statut=bientot">
      <span class="pastille-chiffre <%= aTraiter.bientotExpires ? 'chaude' : '' %>"><%= aTraiter.bientotExpires %></span>
      <span>Abonnements qui finissent dans 3 jours</span><%- icone('chevron') %>
    </a>
  </div>
  <% } %>
</section>

<section class="grille-graph" aria-label="30 derniers jours">
  <%- include('partials/graphique', {
        g: graphiqueVideos,
        titreGraph: 'Vidéos fabriquées' + (avecDemo ? ' (DÉMO incluse)' : ''),
        resume: f.pluriel(graphiqueVideos.total, 'vidéo') + ' en 30 jours',
      }) %>
  <%- include('partials/graphique', {
        g: graphiqueRevenus,
        titreGraph: 'Revenus validés' + (avecDemo ? ' (DÉMO incluse)' : ''),
        resume: f.fcfa(graphiqueRevenus.total) + ' en 30 jours',
      }) %>
</section>

<%- include('partials/bas') %>
