<%# PAGE 1 — Tableau de bord : revenus (courbe cumulée), indicateurs, graphiques 30 jours, à traiter, activité récente %>
<%- include('partials/haut') %>

<div class="tete-page empilable">
  <div>
    <p class="surtitre"><%= f.dateLongue() %></p>
    <h1>Bonjour 👋</h1>
  </div>
  <% if (existeDemo) { %>
  <%# Les données DÉMO ne sont jamais mélangées aux vrais chiffres sans le dire %>
  <div class="bascule-vue" role="group" aria-label="Chiffres affichés">
    <a href="/" class="<%= avecDemo ? '' : 'active' %>" <%- avecDemo ? '' : 'aria-current="true"' %>>Chiffres réels</a>
    <a href="/?vue=demo" class="<%= avecDemo ? 'active' : '' %>" <%- avecDemo ? 'aria-current="true"' : '' %>>Avec la DÉMO</a>
  </div>
  <% } %>
</div>

<% if (avecDemo) { %>
<div class="bandeau-demo" role="note"><%- icone('alerte') %><span><strong>DÉMO</strong> — ces chiffres incluent des données fictives de démonstration. Ce ne sont pas vos vrais résultats.</span></div>
<% } %>

<%# ---- Raccourcis ---- %>
<nav class="raccourcis" aria-label="Raccourcis">
  <a class="raccourci" href="/clients/nouveau"><%- icone('ajouter') %>Client</a>
  <a class="raccourci" href="/commandes/nouvelle"><%- icone('ajouter') %>Commande</a>
  <a class="raccourci" href="/paiements/nouveau"><%- icone('ajouter') %>Paiement</a>
  <a class="raccourci" href="/gabarits/nouveau"><%- icone('ajouter') %>Gabarit</a>
</nav>

<%# ---- Revenus du mois + courbe cumulée (mois en cours vs mois précédent) ---- %>
<section class="hero" aria-label="Revenus du mois">
  <div class="hero-haut"><%- icone('paiements') %><span>Revenus du mois</span><%- badgeDemo(avecDemo) %></div>
  <p class="hero-chiffre"><%= f.fcfa(chiffres.revenusMois) %></p>
  <div class="hero-bas">
    <% if (variations.revenus) { %>
    <span class="variation <%= variations.revenus.sens %>"><%= variations.revenus.texte %></span>
    <span>vs même période en <%= moisPrecedent %></span>
    <% } %>
    <span class="hero-compte"><%= f.pluriel(chiffres.paiementsMois, 'paiement validé', 'paiements validés') %> en <%= f.moisEnCours() %></span>
  </div>
  <%- include('partials/graphique-cumul', { g: graphiqueCumul }) %>
</section>

<%# ---- Indicateurs ---- %>
<section class="tuiles" aria-label="Chiffres clés">
  <a class="tuile" href="/clients">
    <span class="tuile-haut"><span class="tuile-icone accent"><%- icone('clients') %></span><span class="tuile-label">Clients</span></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.clients) %><%- badgeDemo(avecDemo) %></strong>
    <span class="tuile-detail">
      <% if (chiffres.nouveauxClients) { %><span class="variation hausse">↑ +<%= f.nombre(chiffres.nouveauxClients) %></span>ce mois<% } else { %>aucun nouveau ce mois<% } %>
    </span>
  </a>
  <a class="tuile" href="/clients?statut=actif">
    <span class="tuile-haut"><span class="tuile-icone accent"><%- icone('check') %></span><span class="tuile-label">Abonnés actifs</span></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.actifs) %><%- badgeDemo(avecDemo) %></strong>
    <span class="tuile-detail">
      <%= chiffres.clients ? `${Math.round((chiffres.actifs / chiffres.clients) * 100)} % des clients` : '—' %> · <%= f.nombre(chiffres.essais) %> en essai
    </span>
  </a>
  <a class="tuile" href="/commandes?statut=terminee">
    <span class="tuile-haut"><span class="tuile-icone attention"><%- icone('videos') %></span><span class="tuile-label">Vidéos aujourd'hui</span></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.videosJour) %><%- badgeDemo(avecDemo) %></strong>
    <span class="tuile-detail"><span class="variation <%= variations.videosJour.sens %>"><%= variations.videosJour.texte %></span>vs hier</span>
  </a>
  <a class="tuile" href="/commandes?statut=terminee">
    <span class="tuile-haut"><span class="tuile-icone attention"><%- icone('graphique') %></span><span class="tuile-label">Vidéos ce mois</span></span>
    <strong class="tuile-valeur"><%= f.nombre(chiffres.videosMois) %><%- badgeDemo(avecDemo) %></strong>
    <span class="tuile-detail">
      <% if (variations.videosMois) { %><span class="variation <%= variations.videosMois.sens %>"><%= variations.videosMois.texte %></span>vs <%= moisPrecedent %><% } else { %><%= f.moisEnCours() %><% } %>
    </span>
  </a>
</section>

<% if (!demarrage.offres || !demarrage.gabarits || !demarrage.clients) { %>
<section class="carte">
  <h2 class="carte-titre">Premiers pas</h2>
  <ol class="etapes">
    <li><% if (demarrage.offres) { %><span class="fait"><%- icone('check') %>Créer vos offres</span><% } else { %><a href="/offres/nouvelle"><%- icone('offres') %>1. Créer vos offres d'abonnement</a><% } %></li>
    <li><% if (demarrage.gabarits) { %><span class="fait"><%- icone('check') %>Créer vos gabarits</span><% } else { %><a href="/gabarits/nouveau"><%- icone('gabarits') %>2. Créer vos gabarits de vidéos</a><% } %></li>
    <li><% if (demarrage.clients) { %><span class="fait"><%- icone('check') %>Ajouter un client</span><% } else { %><a href="/clients/nouveau"><%- icone('clients') %>3. Ajouter votre premier client</a><% } %></li>
    <% if (!existeDemo) { %>
    <li><a href="/parametres#demo"><%- icone('oeil') %>Voir l'app remplie avec des données DÉMO</a></li>
    <% } %>
  </ol>
</section>
<% } %>

<%# ---- 30 derniers jours : vidéos et revenus par jour ---- %>
<div class="grille-graph">
  <%- include('partials/graphique', {
        g: graphiqueVideos,
        titreGraph: 'Vidéos fabriquées par jour' + (avecDemo ? ' (DÉMO incluse)' : ''),
        resume: f.pluriel(graphiqueVideos.total, 'vidéo') + ' en 30 jours',
      }) %>
  <%- include('partials/graphique', {
        g: graphiqueRevenus,
        titreGraph: 'Revenus validés par jour' + (avecDemo ? ' (DÉMO incluse)' : ''),
        resume: f.fcfa(graphiqueRevenus.total) + ' en 30 jours',
      }) %>
</div>

<div class="grille-2">
  <%# ---- À traiter ---- %>
  <section class="carte" aria-labelledby="titre-a-traiter">
    <h2 class="carte-titre" id="titre-a-traiter">À traiter <%- badgeDemo(avecDemo) %></h2>
    <% const total = aTraiter.paiements + aTraiter.attente + aTraiter.echecs + aTraiter.bientotExpires; %>
    <% if (!total) { %>
    <p class="aide">Rien à traiter pour le moment ✅</p>
    <% } else { %>
    <div class="actions-liste">
      <a class="action-ligne" href="/paiements?statut=en_attente">
        <span class="pastille-chiffre <%= aTraiter.paiements ? 'chaude' : '' %>"><%= aTraiter.paiements %></span>
        <span>Paiements à valider</span><%- icone('chevron') %>
      </a>
      <a class="action-ligne" href="/commandes?statut=en_attente">
        <span class="pastille-chiffre <%= aTraiter.attente ? 'chaude' : '' %>"><%= aTraiter.attente %></span>
        <span>Vidéos en attente de rendu</span><%- icone('chevron') %>
      </a>
      <a class="action-ligne" href="/commandes?statut=echec">
        <span class="pastille-chiffre <%= aTraiter.echecs ? 'chaude' : '' %>"><%= aTraiter.echecs %></span>
        <span>Vidéos en échec</span><%- icone('chevron') %>
      </a>
      <a class="action-ligne" href="/clients?statut=bientot">
        <span class="pastille-chiffre <%= aTraiter.bientotExpires ? 'chaude' : '' %>"><%= aTraiter.bientotExpires %></span>
        <span>Abonnements qui finissent dans 3 jours</span><%- icone('chevron') %>
      </a>
    </div>
    <% } %>
  </section>

  <%# ---- Abonnés actifs par offre ---- %>
  <section class="carte" aria-labelledby="titre-par-offre">
    <h2 class="carte-titre" id="titre-par-offre"><span>Abonnés par offre <%- badgeDemo(avecDemo) %></span><a href="/offres">Gérer</a></h2>
    <% if (!parOffre.length) { %>
    <p class="aide">Aucun abonné actif pour l'instant. Les abonnés apparaissent ici dès qu'un paiement est validé.</p>
    <% } else { %>
    <div class="repartition">
      <% parOffre.forEach((o) => { %>
      <div class="repartition-ligne">
        <div class="repartition-tete">
          <span><%= o.nom %> <%- badgeDemo(o.est_demo) %></span>
          <strong><%= f.pluriel(o.abonnes, 'abonné') %> · <%= Math.round((o.abonnes / chiffres.actifs) * 100) %> %</strong>
        </div>
        <progress max="<%= chiffres.actifs %>" value="<%= o.abonnes %>"><%= o.abonnes %> sur <%= chiffres.actifs %></progress>
        <span class="aide"><%= f.fcfa(o.prix_fcfa) %> / <%= o.duree_jours %> jours</span>
      </div>
      <% }) %>
    </div>
    <p class="repartition-total"><span>Revenu mensuel récurrent estimé</span><strong><%= f.fcfa(revenuRecurrent) %></strong></p>
    <% } %>
  </section>

  <%# ---- Derniers paiements ---- %>
  <section class="carte liste">
    <h2 class="carte-titre ligne">Derniers paiements <a href="/paiements">Tout voir</a></h2>
    <% if (!derniersPaiements.length) { %><p class="aide ligne">Aucun paiement pour l'instant.</p><% } %>
    <% derniersPaiements.forEach((p) => { %>
    <a class="ligne" href="/paiements/<%= p.id %>">
      <span class="avatar <%= p.statut === 'en_attente' ? 'attention' : '' %>"><%- icone('paiements') %></span>
      <span class="ligne-corps">
        <span class="ligne-titre"><span class="nom"><%= p.client_nom %></span><%- badgeDemo(p.est_demo) %></span>
        <span class="ligne-sous"><%= p.moyen %> · <%= f.quand(p.date_paiement) %></span>
      </span>
      <span class="ligne-fin">
        <span class="ligne-montant"><%= f.fcfa(p.montant_fcfa) %></span>
        <%- badgeStatut('paiement', p.statut) %>
      </span>
    </a>
    <% }) %>
  </section>

  <%# ---- Dernières vidéos ---- %>
  <section class="carte liste">
    <h2 class="carte-titre ligne">Dernières vidéos <a href="/commandes">Tout voir</a></h2>
    <% if (!dernieresCommandes.length) { %><p class="aide ligne">Aucune commande pour l'instant.</p><% } %>
    <% dernieresCommandes.forEach((c) => { %>
    <a class="ligne" href="/commandes/<%= c.id %>">
      <% if (c.gabarit_miniature) { %>
      <img class="miniature" src="/fichiers/miniatures/<%= c.gabarit_miniature %>" alt="" loading="lazy">
      <% } else { %>
      <span class="miniature"><%- icone('videos') %></span>
      <% } %>
      <span class="ligne-corps">
        <span class="ligne-titre"><span class="nom">#<%= c.id %> · <%= c.client_nom %></span><%- badgeDemo(c.est_demo) %></span>
        <span class="ligne-sous"><%= c.gabarit_nom || 'Gabarit supprimé' %> · <%= f.quand(c.cree_le) %></span>
      </span>
      <span class="ligne-fin"><%- badgeStatut('commande', c.statut) %></span>
    </a>
    <% }) %>
  </section>
</div>

<%- include('partials/bas') %>
