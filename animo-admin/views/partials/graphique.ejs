<%#
  Petit graphique en colonnes : une colonne par jour (30 jours).
  Variables : g (voir lib/graphique.js), titreGraph, resume.
  - SVG dessiné côté serveur (fonctionne sans JavaScript)
  - toucher/survoler une colonne affiche la valeur (public/js/app.js)
  - le tableau "jour par jour" donne tous les chiffres sans graphique
%>
<% const H = 140; /* hauteur de la zone de tracé, en pixels */ %>
<figure class="carte graph" data-graph>
  <figcaption class="graph-tete">
    <span class="carte-titre"><%= titreGraph %></span>
    <span class="graph-resume"><%= resume %></span>
  </figcaption>
  <div class="graph-zone">
    <div class="graph-axe" aria-hidden="true">
      <span class="graduation haut"><%= g.graduations.haut %></span>
      <span class="graduation milieu"><%= g.graduations.milieu %></span>
      <span class="graduation bas">0</span>
    </div>
    <div class="graph-trace">
      <svg class="graph-svg" width="100%" height="<%= H %>" role="img" aria-label="<%= titreGraph %>, 30 derniers jours : <%= resume %>">
        <line class="grille" x1="0" x2="100%" y1="0.5" y2="0.5"/>
        <line class="grille" x1="0" x2="100%" y1="<%= H / 2 %>" y2="<%= H / 2 %>"/>
        <% g.colonnes.forEach((c) => {
             const h = c.valeur > 0 ? Math.max(3, Math.round(c.proportion * H)) : 0; %>
        <g class="colonne" tabindex="0" data-libelle="<%= c.aujourdhui ? "Aujourd'hui" : c.libelle %>" data-texte="<%= c.texte %>" aria-label="<%= c.libelle %> : <%= c.texte %>">
          <rect class="zone" x="<%= c.x.toFixed(3) %>%" y="0" width="<%= c.largeur.toFixed(3) %>%" height="<%= H %>"/>
          <% if (h) { %>
          <%# Barre arrondie en haut : on la prolonge sous la ligne de base, où elle est coupée %>
          <rect class="barre <%= c.aujourdhui ? 'barre-auj' : '' %>" x="<%= (c.x + c.largeur * 0.15).toFixed(3) %>%" y="<%= H - h %>" width="<%= (c.largeur * 0.7).toFixed(3) %>%" height="<%= h + 6 %>" rx="3"/>
          <% } %>
        </g>
        <% }) %>
        <line class="ligne-base" x1="0" x2="100%" y1="<%= H - 0.5 %>" y2="<%= H - 0.5 %>"/>
      </svg>
      <div class="graph-bulle" hidden></div>
    </div>
    <div class="graph-dates" aria-hidden="true">
      <span><%= g.debut %></span><span><%= g.milieu %></span><span>Aujourd'hui</span>
    </div>
  </div>
  <details class="graph-tableau">
    <summary>Voir les chiffres jour par jour</summary>
    <table>
      <thead><tr><th scope="col">Jour</th><th scope="col"><%= titreGraph %></th></tr></thead>
      <tbody>
        <% g.colonnes.slice().reverse().forEach((c) => { %>
        <tr><td><%= c.aujourdhui ? "Aujourd'hui" : c.libelle %></td><td><%= c.texte %></td></tr>
        <% }) %>
      </tbody>
    </table>
  </details>
</figure>
