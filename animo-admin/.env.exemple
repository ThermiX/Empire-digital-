# =============================================================
#  Réglages d'Animo admin — copiez ce fichier en ".env"
#  (cp .env.exemple .env) puis modifiez les valeurs.
#  Ne partagez jamais votre fichier .env.
# =============================================================

# Port du serveur web
PORT=3000

# Fuseau horaire (Africa/Abidjan, Africa/Dakar, Africa/Douala, Africa/Kinshasa…)
FUSEAU_HORAIRE=Africa/Abidjan

# Déconnexion automatique après X minutes sans activité
DECONNEXION_APRES_MINUTES=20

# Mettre "oui" quand l'app est en ligne derrière HTTPS (Render, Railway, Nginx…)
DERRIERE_PROXY=non

# UNIQUEMENT pour un aperçu intégré (panneau d'aperçu de l'app Claude) :
# autorise l'affichage dans un cadre. Toujours "non" en production.
MODE_APERCU=non

# Adresse publique de l'app, utilisée dans le lien vidéo envoyé au client
# Exemple : https://admin.animo.africa   (laisser vide en local)
URL_PUBLIQUE=

# Taille maximale d'une vidéo envoyée (en Mo)
TAILLE_MAX_VIDEO_MO=200

# Dossier des données (base + fichiers). À sauvegarder régulièrement !
DOSSIER_DONNEES=donnees

# Facultatif — hébergeur sans terminal : crée le premier compte admin
# au démarrage s'il n'en existe aucun. Retirez le mot de passe ensuite.
# ADMIN_EMAIL=
# ADMIN_MOT_DE_PASSE=
